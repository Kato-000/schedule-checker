{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScheduleChecker",
  "mainBinaryName": "ScheduleChecker",
  "version": "0.4.10",
  "identifier": "local.schedulechecker.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "予定チェッカー",
        "url": "index.html#/widget",
        "width": 320,
        "height": 540,
        "minWidth": 260,
        "minHeight": 64,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": true
      },
      {
        "label": "main",
        "title": "予定チェッカー",
        "url": "index.html#/main/today",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-src https://www.google.com https://maps.google.com",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Japanese"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
